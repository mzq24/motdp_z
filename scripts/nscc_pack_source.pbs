#!/bin/bash

### Phase 1: Pack source data (.laz + .jpg → route_source.pt)
### CPU-only job, no GPU needed.
### Submit: qsub scripts/nscc_pack_source.pbs

#PBS -l select=1:ncpus=32:mem=128G
#PBS -l walltime=12:00:00
#PBS -P personal-wh.huang
#PBS -N mot_pack_source
#PBS -j oe
#PBS -o out.pack_source.txt
#PBS -M m240117@e.ntu.edu.sg
#PBS -m abe

# ---- User config ----
SCRATCH=/home/users/ntu/wh.huang/scratch
DATASET_PATH=${SCRATCH}/datasets/pdm_lite
CONFIG_PATH=${SCRATCH}/models/pretrained_models/all_towns
MODEL_PATH=${CONFIG_PATH}/model_0030_1.pth
CODE_DIR=${SCRATCH}/z_projects/code/MoT-DP
CONDA_ENV=dpautomotive
LOG_FILE=${SCRATCH}/logs/mot_pack_source_${PBS_JOBID}.log
# ---------------------

source /home/users/ntu/wh.huang/miniconda3/etc/profile.d/conda.sh
conda activate ${CONDA_ENV}

cd ${CODE_DIR}
mkdir -p ${SCRATCH}/logs

echo "=== Phase 1: Packing source data ===" | tee ${LOG_FILE}
echo "Dataset: ${DATASET_PATH}"             | tee -a ${LOG_FILE}
echo "Log:     ${LOG_FILE}"                 | tee -a ${LOG_FILE}
echo "Start:   $(date)"                     | tee -a ${LOG_FILE}

# -u: 禁用 Python 输出缓冲，保证日志实时写入文件
python -u model/transfuser_extractor/preprocess_dataset.py \
  --dataset_path ${DATASET_PATH} \
  --config_path  ${CONFIG_PATH} \
  --model_path   ${MODEL_PATH} \
  --batch_size   32 \
  --device       cpu \
  --mode         pack_source \
  2>&1 | tee -a ${LOG_FILE}

echo "Done: $(date)" | tee -a ${LOG_FILE}
