#!/bin/bash

### Bridge Baseline Training on NSCC ASPIRE 2A
### Submit: qsub scripts/pbs/nscc_train_bridge.pbs

#PBS -l select=1:ngpus=4:ncpus=32:mem=440G
#PBS -l walltime=20:00:00
#PBS -P personal-wh.huang
#PBS -N bridge_train
#PBS -j oe
#PBS -o out.bridge_train.txt
#PBS -M m240117@e.ntu.edu.sg
#PBS -m abe

# ---- User config ----
SCRATCH=/home/users/ntu/wh.huang/scratch
CODE_DIR=${SCRATCH}/z_projects/code/motdp_z
DATA_ROOT=${SCRATCH}/z_projects/dataset/pdm_lite
CONFIG_PATH=${CODE_DIR}/bridge_baseline/bd_config_hpc.yaml
CONDA_ENV=dpautomotive
LOG_FILE=${CODE_DIR}/logs/bridge_train_${PBS_JOBID}.log
USE_TMPFS=true   # true: copy BEV cache to /tmp for faster IO
# ---------------------

# Derived paths
CACHE_DIR=${DATA_ROOT}/tmp_data

source /home/users/ntu/wh.huang/miniconda3/etc/profile.d/conda.sh
conda activate ${CONDA_ENV}

cd ${CODE_DIR}
mkdir -p ${CODE_DIR}/logs

echo "=== Bridge Baseline Training ===" | tee ${LOG_FILE}
echo "Config:  ${CONFIG_PATH}"  | tee -a ${LOG_FILE}
echo "Dataset: ${DATA_ROOT}"    | tee -a ${LOG_FILE}
echo "GPUs:    $(nvidia-smi --query-gpu=name --format=csv,noheader)" | tee -a ${LOG_FILE}
echo "Start:   $(date)"         | tee -a ${LOG_FILE}

# ---- Copy BEV cache to tmpfs ----
if [ "${USE_TMPFS}" = true ]; then
    echo "Copying BEV cache to /tmp/tmp_data ..." | tee -a ${LOG_FILE}
    mkdir -p /tmp/tmp_data
    rsync --progress ${CACHE_DIR}/feature_index.pkl /tmp/tmp_data/
    rsync --progress ${CACHE_DIR}/bev_features_fp16.bin /tmp/tmp_data/
    rsync --progress ${CACHE_DIR}/bev_upsamples_fp16.bin /tmp/tmp_data/
    echo "BEV cache copied: $(du -sh /tmp/tmp_data/)" | tee -a ${LOG_FILE}
fi

# ---- Compute norm stats (one-time, fast mode) ----
if [ ! -f "${CODE_DIR}/.bridge_stats_done" ]; then
    echo "Computing route + traj norm stats ..." | tee -a ${LOG_FILE}
    python bridge_baseline/scripts/compute_route_stats.py \
        --dataset_path ${DATA_ROOT}/tmp_data/train \
        --key all --fast \
        --output_yaml ${CONFIG_PATH} \
        2>&1 | tee -a ${LOG_FILE}
    touch "${CODE_DIR}/.bridge_stats_done"
fi

# ---- Training ----
export CUDA_VISIBLE_DEVICES=0,1,2,3
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

torchrun \
    --nnodes=1 \
    --nproc_per_node=4 \
    --max_restarts=0 \
    --rdzv_id=200 \
    --rdzv_backend=c10d \
    --rdzv_endpoint=localhost:29501 \
    bridge_baseline/train.py \
    --config_path "${CONFIG_PATH}" \
    2>&1 | tee -a ${LOG_FILE}

echo "Done: $(date)" | tee -a ${LOG_FILE}
