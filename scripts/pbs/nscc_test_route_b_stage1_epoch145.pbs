#!/bin/bash

### NSCC_m Route-B stage1 epoch145 evaluation
### Submit:
###   qsub scripts/pbs/nscc_test_route_b_stage1_epoch145.pbs
### Optional route override:
###   qsub -v ROUTES_SUBSET_LIST="17569 17563" scripts/pbs/nscc_test_route_b_stage1_epoch145.pbs

#PBS -l select=1:ngpus=1:ncpus=8:mem=120G
#PBS -l walltime=12:00:00
#PBS -P personal-wh.huang
#PBS -N mot_stage1_eval
#PBS -j oe
#PBS -o out.stage1_eval.txt
#PBS -M m240117@e.ntu.edu.sg
#PBS -m abe

set -euo pipefail

# ---- User config ----
WORKTREE_DIR=/scratch/users/ntu/m240117/code/others/motdp_stage1_test_0407
B2D_ROOT=/home/users/ntu/m240117/scratch/code/others/Bench2Drive
TEAM_AGENT=${WORKTREE_DIR}/team_code/route_b_b2d_agent.py
TEAM_CONFIG=${WORKTREE_DIR}/config/pdm_nscc_route_b_stage1_epoch145.yaml
LAUNCHER=${WORKTREE_DIR}/scripts/training/run_route_b_epoch145_single_gpu_dual_task.sh
CONDA_SH=/home/users/ntu/m240117/miniconda3/etc/profile.d/conda.sh
CONDA_ENV=dpauto
DPAUTO_BIN=/home/users/ntu/m240117/miniconda3/envs/dpauto/bin

DATE=${DATE:-0407_epoch145_nscc}
PLANNER_TYPE=${PLANNER_TYPE:-epoch145_stage1}
ALGO=${ALGO:-route_b}
SAVE_PATH=${SAVE_PATH:-${B2D_ROOT}/eval_M_${ALGO}_${DATE}}
FULL_ROUTES_XML=${FULL_ROUTES_XML:-${B2D_ROOT}/leaderboard/data/bench2drive220.xml}
ROUTES_SUBSET_LIST=${ROUTES_SUBSET_LIST:-17569 17563}

SOFT_SPEED_LIMIT_MS=${SOFT_SPEED_LIMIT_MS:-20}
HARD_SPEED_LIMIT_MS=${HARD_SPEED_LIMIT_MS:-0}
SPEED_SOURCE=${SPEED_SOURCE:-traj_05s}
NUM_INFERENCE_STEPS_OVERRIDE=${NUM_INFERENCE_STEPS_OVERRIDE:-10}
GPU_RANK_LIST=${GPU_RANK_LIST:-0 0}
TASK_LIST=${TASK_LIST:-0 1}

LOG_DIR=${WORKTREE_DIR}/logs
LOG_FILE=${LOG_DIR}/stage1_eval_${PBS_JOBID}.log
# ---------------------

source "${CONDA_SH}"
conda activate "${CONDA_ENV}"

mkdir -p "${LOG_DIR}"

echo "=== Route-B Stage1 Epoch145 Eval ===" | tee "${LOG_FILE}"
echo "Worktree:     ${WORKTREE_DIR}" | tee -a "${LOG_FILE}"
echo "Bench2Drive:  ${B2D_ROOT}" | tee -a "${LOG_FILE}"
echo "TEAM_AGENT:   ${TEAM_AGENT}" | tee -a "${LOG_FILE}"
echo "TEAM_CONFIG:  ${TEAM_CONFIG}" | tee -a "${LOG_FILE}"
echo "Launcher:     ${LAUNCHER}" | tee -a "${LOG_FILE}"
echo "Routes XML:   ${FULL_ROUTES_XML}" | tee -a "${LOG_FILE}"
echo "Route IDs:    ${ROUTES_SUBSET_LIST}" | tee -a "${LOG_FILE}"
echo "Speed source: ${SPEED_SOURCE}" | tee -a "${LOG_FILE}"
echo "Soft cap:     ${SOFT_SPEED_LIMIT_MS}" | tee -a "${LOG_FILE}"
echo "Hard cap:     ${HARD_SPEED_LIMIT_MS}" | tee -a "${LOG_FILE}"
echo "Save path:    ${SAVE_PATH}" | tee -a "${LOG_FILE}"
echo "Start:        $(date)" | tee -a "${LOG_FILE}"

cd "${WORKTREE_DIR}"

export PATH="${DPAUTO_BIN}:$PATH"
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

B2D_ROOT="${B2D_ROOT}" \
TEAM_AGENT="${TEAM_AGENT}" \
TEAM_CONFIG="${TEAM_CONFIG}" \
DPAUTO_BIN="${DPAUTO_BIN}" \
FULL_ROUTES_XML="${FULL_ROUTES_XML}" \
ROUTES_SUBSET_LIST="${ROUTES_SUBSET_LIST}" \
SAVE_PATH="${SAVE_PATH}" \
DATE="${DATE}" \
PLANNER_TYPE="${PLANNER_TYPE}" \
ALGO="${ALGO}" \
SOFT_SPEED_LIMIT_MS="${SOFT_SPEED_LIMIT_MS}" \
HARD_SPEED_LIMIT_MS="${HARD_SPEED_LIMIT_MS}" \
SPEED_SOURCE="${SPEED_SOURCE}" \
NUM_INFERENCE_STEPS_OVERRIDE="${NUM_INFERENCE_STEPS_OVERRIDE}" \
GPU_RANK_LIST="${GPU_RANK_LIST}" \
TASK_LIST="${TASK_LIST}" \
bash "${LAUNCHER}" 2>&1 | tee -a "${LOG_FILE}"

echo "Done: $(date)" | tee -a "${LOG_FILE}"
